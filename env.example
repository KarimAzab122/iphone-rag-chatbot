# Groq API key used by the chat language model
GROQ_API_KEY=your_groq_api_key

# URL of your Qdrant Cloud cluster
QDRANT_URL=your_qdrant_cluster_url

# API key used to access the Qdrant Cloud database
QDRANT_API_KEY=your_qdrant_api_key

# Name of the Qdrant collection containing the PDF embeddings
COLLECTION_NAME=iphone_user_guide

# Port used to run the Chainlit application
PORT=8000